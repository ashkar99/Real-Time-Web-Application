<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitLab Issues Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; padding-top: 2rem; }
        .issue-card { transition: all 0.2s ease-in-out; }
        .issue-card:hover { transform: translateY(-3px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="container">
        <% if (!authenticated) { %>
            <div class="row justify-content-center mt-5">
                <div class="col-md-6 text-center">
                    <h1 class="mb-4">B3 Production Dashboard</h1>
                    <p class="text-muted mb-4">You must authenticate via GitLab to access the repository data.</p>
                    <a href="/auth/login" class="btn btn-lg btn-primary text-white fw-bold">
                        Log In with GitLab OAuth
                    </a>
                </div>
            </div>
        <% } else { %>
            <header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
              <div>
                  <h1 class="h3 text-dark">System Repository Issues</h1>
                  <p class="text-muted mb-0">Real-time monitoring active.</p>
              </div>
              <div>
                  <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#createIssueModal">
                      + Create Issue
                  </button>
                  <a href="/auth/logout" class="btn btn-outline-secondary">Log Out</a>
              </div>
            </header>

        <div class="row" id="issue-list">
            <ul class="nav nav-tabs" id="issueTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active text-success fw-bold" id="open-tab" data-bs-toggle="tab" data-bs-target="#open-issues" type="button" role="tab">Active Issues</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link text-secondary fw-bold" id="closed-tab" data-bs-toggle="tab" data-bs-target="#closed-issues" type="button" role="tab">Inactive Issues</button>
                </li>
            </ul>

            <div class="tab-content mt-4" id="issueTabsContent">
                
                <div class="tab-pane fade show active" id="open-issues" role="tabpanel">
                    <div class="row" id="open-issue-list">
                        <% issues.filter(i => i.state === 'opened').forEach(issue => { %>
                            <div class="col-md-6 col-lg-4 mb-3 issue-node" id="issue-<%= issue.id %>">
                                <div class="card issue-card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title text-truncate" title="<%= issue.title %>">#<%= issue.iid %>: <%= issue.title %></h5>
                                        <span class="badge bg-success issue-state-badge">opened</span>
                                        <div class="mt-1 mb-2 issue-labels-container">
                                            <% if (issue.labels && issue.labels.length > 0) { %>
                                                <% issue.labels.forEach(label => { %>
                                                    <span class="badge rounded-pill border me-1" style="background-color: <%= label.color %>; color: <%= label.text_color %>;">
                                                        <%= label.name %>
                                                    </span>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                        <p class="card-text small mt-2 mb-1 issue-description text-truncate" title="<%= issue.description || 'No description provided.' %>">
                                            <%= issue.description ? issue.description : '' %>
                                        </p>
                                        
                                        <p class="card-text text-muted small mt-2">
                                            Created by <strong><%= issue.author.name %></strong> on <%= new Date(issue.created_at).toLocaleDateString() %>
                                            <span class="issue-closed-by d-block mt-1 text-danger"></span>
                                        </p>
                                        <button class="btn btn-sm btn-outline-danger mt-2 action-issue-btn" data-iid="<%= issue.iid %>" data-action="close">Close Issue</button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="tab-pane fade" id="closed-issues" role="tabpanel">
                    <div class="row" id="closed-issue-list">
                        <% issues.filter(i => i.state === 'closed').forEach(issue => { %>
                            <div class="col-md-6 col-lg-4 mb-3 issue-node" id="issue-<%= issue.id %>">
                                <div class="card issue-card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title text-truncate" title="<%= issue.title %>">#<%= issue.iid %>: <%= issue.title %></h5>
                                        <span class="badge bg-secondary issue-state-badge">closed</span>
                                        <div class="mt-1 mb-2 issue-labels-container">
                                            <% if (issue.labels && issue.labels.length > 0) { %>
                                                <% issue.labels.forEach(label => { %>
                                                    <span class="badge rounded-pill border me-1" style="background-color: <%= label.color %>; color: <%= label.text_color %>;">
                                                        <%= label.name %>
                                                    </span>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                        <p class="card-text small mt-2 mb-1 issue-description text-truncate" title="<%= issue.description || 'No description provided.' %>">
                                            <%= issue.description ? issue.description : '' %>
                                        </p>
                                        
                                        <p class="card-text text-muted small mt-2">
                                            Created by <strong><%= issue.author.name %></strong> on <%= new Date(issue.created_at).toLocaleDateString() %>
                                            <span class="issue-closed-by d-block mt-1 text-danger">
                                                <% if (issue.closed_by) { %>
                                                    Closed by <strong><%= issue.closed_by.name %></strong> on <%= new Date(issue.closed_at || issue.updated_at).toLocaleDateString() %>
                                                <% } %>
                                            </span>
                                        </p>
                                        <button class="btn btn-sm btn-outline-success mt-2 action-issue-btn" data-iid="<%= issue.iid %>" data-action="reopen">Reopen Issue</button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

            </div>
        </div>
        <% } %>
    </div>

    <template id="issue-template">
        <div class="col-md-6 col-lg-4 mb-3 issue-node">
            <div class="card issue-card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-truncate issue-title"></h5>
                    <span class="badge bg-success issue-state-badge">opened</span>
                    <span class="badge bg-primary ms-1">NEW</span>
                    <div class="mt-1 mb-2 issue-labels-container"></div>
                    
                    <p class="card-text small mt-2 mb-1 issue-description text-truncate"></p>
                    
                    <div class="card-text text-muted small mt-2">
                        <span class="issue-date-author"></span>
                        <span class="issue-closed-by d-block mt-1 text-danger"></span>
                    </div>
                    <button class="btn btn-sm btn-outline-danger mt-2 action-issue-btn" data-action="close">Close Issue</button>
                </div>
            </div>
        </div>
    </template>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="notification-zone"></div>

    <div class="modal fade" id="createIssueModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title">Draft New Issue</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                  <form id="create-issue-form">
                      <div class="mb-3">
                          <label for="issue-title" class="form-label fw-bold">Title</label>
                          <input type="text" class="form-control" id="issue-title" required>
                      </div>
                      <div class="mb-3">
                          <label for="issue-desc" class="form-label fw-bold">Description</label>
                          <textarea class="form-control" id="issue-desc" rows="4"></textarea>
                      </div>
                      <button type="submit" class="btn btn-success w-100" id="submit-issue-btn">Deploy Issue</button>
                  </form>
              </div>
          </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"> </script>
    <script src="/js/app.js"></script>
</body>
</html>