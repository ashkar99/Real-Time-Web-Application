<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitLab Issues Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; padding-top: 2rem; }
        .issue-card { transition: all 0.2s ease-in-out; }
        .issue-card:hover { transform: translateY(-3px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="container">
        <header class="pb-3 mb-4 border-bottom">
            <h1 class="h3 text-dark">System Repository Issues</h1>
            <p class="text-muted">Real-time monitoring active.</p>
        </header>

        <div class="row" id="issue-list">
            <% issues.forEach(issue => { %>
                <div class="col-md-6 col-lg-4 mb-3 issue-node" id="issue-<%= issue.id %>">
                    <div class="card issue-card h-100">
                        <div class="card-body">
                            <h5 class="card-title text-truncate" title="<%= issue.title %>">
                                #<%= issue.iid %>: <%= issue.title %>
                            </h5>
                            <span class="badge bg-success"><%= issue.state %></span>
                            <p class="card-text text-muted small mt-2">
                                Created: <%= new Date(issue.created_at).toLocaleDateString() %>
                            </p>
                            <button class="btn btn-sm btn-outline-danger mt-2 close-issue-btn" data-iid="<%= issue.iid %>"> Close Issue </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <template id="issue-template">
        <div class="col-md-6 col-lg-4 mb-3 issue-node">
            <div class="card issue-card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-truncate issue-title"></h5>
                    <span class="badge bg-success issue-state"></span>
                    <span class="badge bg-primary ms-1">NEW (Real-time)</span>
                    <p class="card-text text-muted small mt-2 issue-date"></p>
                    <button class="btn btn-sm btn-outline-danger mt-2 close-issue-btn"> Close Issue </button>
                </div>
            </div>
        </div>
    </template>

    <script src="/js/app.js"></script>
</body>
</html>